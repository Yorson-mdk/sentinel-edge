{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "sentinel-edge",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    { "binding": "IDS_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "ORIGIN_URL": "https://your-origin.example.com",
    "BLOCK_MODE": "false",
    "RATE_LIMIT": "90",
    "WINDOW_SECONDS": "60",
    "RETENTION_HOURS": "72"
  },
  "observability": { "enabled": true }
}
